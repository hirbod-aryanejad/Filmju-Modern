<UserControl x:Class="Filmju_Modern.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="190">

    <Border Background="#1e202c">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- Sidebar styles -->
            <Grid.Resources>

                <Style x:Key="SidebarButton"
                       TargetType="Button">

                    <Setter Property="Height" Value="50"/>
                    <Setter Property="Background" Value="#1e202c"/>
                    <Setter Property="Foreground" Value="#8a8eaf"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>

                    <Setter Property="Template">
                        <Setter.Value>

                            <ControlTemplate TargetType="Button">

                                <Border x:Name="ButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="25,0,0,25">

                                    <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="Center"/>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver"
                                             Value="True">

                                        <Setter TargetName="ButtonBorder"
                                                Property="Background"
                                                Value="#13141c"/>

                                        <Setter Property="Foreground"
                                                Value="#f5ff63"/>

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Setter.Value>
                    </Setter>

                </Style>


                <!-- Logout button -->
                <Style x:Key="LogoutButton"
                       TargetType="Button">

                    <Setter Property="Height" Value="50"/>
                    <Setter Property="Background" Value="#1e202c"/>
                    <Setter Property="Foreground" Value="#8a8eaf"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>

                    <Setter Property="Template">
                        <Setter.Value>

                            <ControlTemplate TargetType="Button">

                                <Border x:Name="LogoutButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="25">

                                    <ContentPresenter
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="Center"/>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver"
                                             Value="True">

                                        <Setter TargetName="LogoutButtonBorder"
                                                Property="Background"
                                                Value="#271515"/>

                                        <Setter Property="Foreground"
                                                Value="#dc5858"/>

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Setter.Value>
                    </Setter>

                </Style>

            </Grid.Resources>


            <!-- Top of sidebar -->
            <StackPanel Grid.Row="0">

                <TextBlock Text="FILMJU"
                           FontSize="32"
                           Foreground="DarkSlateGray"
                           HorizontalAlignment="Center"
                           Margin="20"/>

                <Button Content="Home"
                        Style="{StaticResource SidebarButton}"
                        Click="HomeButton_Click"/>

                <Button Content="Favorites"
                        Style="{StaticResource SidebarButton}"
                        Click="FavoritesButton_Click"/>

                <Button Content="Settings"
                        Style="{StaticResource SidebarButton}"
                        Click="SettingsButton_Click"/>

            </StackPanel>


            <!-- Bottom of sidebar -->
            <Button Grid.Row="1"
                    Content="Logout"
                    Style="{StaticResource LogoutButton}"
                    Margin="10,0,10,8"
                    Click="LogoutButton_Click"/>

        </Grid>

    </Border>

</UserControl>

