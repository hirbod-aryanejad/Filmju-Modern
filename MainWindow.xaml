<Window x:Class="Filmju_Modern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Width="1200"
        Height="700"
        Background="#13141c">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Window button styles -->
        <Grid.Resources>

            <Style x:Key="WindowButton"
                   TargetType="Button">

                <Setter Property="Background"
                        Value="Transparent"/>

                <Setter Property="Foreground"
                        Value="#708a8eaf"/>

                <Setter Property="BorderThickness"
                        Value="0"/>

                <Setter Property="FontSize"
                        Value="16"/>

                <Setter Property="Template">
                    <Setter.Value>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">


                                    <Setter TargetName="ButtonBorder"
                                            Property="Background"
                                            Value="#1e202c"/>

                                    <Setter Property="Foreground"
                                            Value="#f5ff63"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>
                </Setter>

            </Style>

            <!-- Close button -->
            <Style x:Key="WindowCloseButton"
                   TargetType="Button">

                <Setter Property="Background"
                        Value="Transparent"/>

                <Setter Property="Foreground"
                        Value="#808a8eaf"/>

                <Setter Property="BorderThickness"
                        Value="0"/>

                <Setter Property="FontSize"
                        Value="16"/>

                <Setter Property="Template">
                    <Setter.Value>

                        <ControlTemplate TargetType="Button">

                            <Border x:Name="CloseButtonBorder"
                                    Background="{TemplateBinding Background}">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter TargetName="CloseButtonBorder"
                                            Property="Background"
                                            Value="#3a1515"/>

                                    <Setter Property="Foreground"
                                            Value="#ff5555"/>

                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>

                    </Setter.Value>
                </Setter>

            </Style>

        </Grid.Resources>



        <!-- Sidebar -->
        <Border
            Grid.Column="0"
        Background="#1e202c" Grid.RowSpan="2">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar button styles -->
                <Grid.Resources>

                    <Style x:Key="SidebarButton" TargetType="Button">

                        <Setter Property="Height" Value="50"/>
                        <Setter Property="Background" Value="#1e202c"/>
                        <Setter Property="Foreground" Value="#8a8eaf"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">

                                    <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="25,0,0,25">

                                        <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsMouseOver"
                                     Value="True">

                                            <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#13141c"/>

                                            <Setter Property="Foreground"
                                        Value="#f5ff63"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                    </Style>


                    <!-- Logout button style -->
                    <Style x:Key="LogoutButton" TargetType="Button">

                        <Setter Property="Height" Value="50"/>
                        <Setter Property="Background" Value="#1e202c"/>
                        <Setter Property="Foreground" Value="#8a8eaf"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">

                                    <Border x:Name="LogoutButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="25,25,25,25">

                                        <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <!-- Logout hover -->
                                        <Trigger Property="IsMouseOver"
                                     Value="True">

                                            <Setter TargetName="LogoutButtonBorder"
                                        Property="Background"
                                        Value="#271515"/>

                                            <Setter Property="Foreground"
                                        Value="#dc5858"/>

                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                    </Style>

                </Grid.Resources>


                <!-- Top of sidebar -->
                <StackPanel Grid.Row="0">

                    <TextBlock Text="FILMJU"
                   FontSize="32"
                   Foreground="DarkSlateGray"
                   HorizontalAlignment="Center"
                   Margin="20"/>

                    <Button Content="Home"
                Style="{StaticResource SidebarButton}"/>
                    <Button Content="Favorites"
                Style="{StaticResource SidebarButton}"/>
                    <Button Content="Settings"
                Style="{StaticResource SidebarButton}"/>

                </StackPanel>


                <!-- Bottom of sidebar -->
                <Button Grid.Row="1"
            Content="Logout"
            Style="{StaticResource LogoutButton}" Margin="10,0,10,8"/>

            </Grid>

        </Border>

        <!-- Main content -->
        <ScrollViewer Grid.Column="1"
              Grid.RowSpan="2"
              VerticalScrollBarVisibility="Visible">

            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar">

                    <Setter Property="Width" Value="6"/>

                    <Setter Property="Background"
            Value="Transparent"/>

                    <Setter Property="Foreground"
            Value="#806a6d85"/>

                    <Setter Property="Template">
                        <Setter.Value>

                            <ControlTemplate TargetType="ScrollBar">

                                <Grid Background="Transparent">

                                    <Track x:Name="PART_Track"
                                        ViewportSize="NaN"
                                        IsDirectionReversed="True" Margin="-8,0,9,0">


                                        <Track.Thumb>

                                            <Thumb Height="45
                                                   " Margin="0,45,0,10">

                                                <Thumb.Template>

                                                    <ControlTemplate TargetType="Thumb">

                                                        <Border x:Name="ThumbBorder"
                                                            Background="#406a6d85"
                                                            CornerRadius="9"/>

                                                        <ControlTemplate.Triggers>

                                                            <Trigger Property="IsMouseOver"
                                                                Value="True">

                                                                <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="#f5ff63"/>

                                                            </Trigger>

                                                        </ControlTemplate.Triggers>

                                                    </ControlTemplate>

                                                </Thumb.Template>

                                            </Thumb>

                                        </Track.Thumb>

                                    </Track>

                                </Grid>

                            </ControlTemplate>

                        </Setter.Value>
                    </Setter>

                </Style>
            </ScrollViewer.Resources>


            <StackPanel>

                <Border Height="300"
                Margin="30"
                Background="DarkSlateGray"
                CornerRadius="15">

                    <TextBlock Text="Featured Movie"
                       Foreground="White"
                       FontSize="30"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                </Border>

                <TextBlock Text="New Movies"
                   Foreground="DarkSlateGray"
                   FontSize="24"
                   Margin="30,10"/>

                <Border Height="300"
            Margin="30"
            Background="DarkSlateGray"
            CornerRadius="15">

                    <TextBlock Text="Featured Movie"
                   Foreground="White"
                   FontSize="30"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

                </Border>

                <TextBlock Text="New TV Shows"
                    Foreground="DarkSlateGray"
                    FontSize="24"
                    Margin="30,10"/>

                <Border Height="300"
            Margin="30"
            Background="Gray"
            CornerRadius="15"/>

                <TextBlock Text="My Favorites"
                    Foreground="DarkSlateGray"
                    FontSize="24"
                    Margin="30,10"/>

                <Border Height="300"
            Margin="30"
            Background="Gray"
            CornerRadius="15"/>

            </StackPanel>

        </ScrollViewer>

        <!-- Drag area -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Margin="0,0,0,5"/>

        <!-- Window controls -->
        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="-"
                    Width="50"
                    Height="40"
                    Style="{StaticResource WindowButton}"
                    Click="MinimizeButton_Click"/>

            <Button Content="□"
                    Width="50"
                    Height="40"
                    Style="{StaticResource WindowButton}"
                    Click="MaximizeButton_Click"/>

            <Button Content="X"
                    Width="50"
                    Height="40"
                    Style="{StaticResource WindowCloseButton}"
                    Click="CloseButton_Click"/>

        </StackPanel>



    </Grid>

</Window>
