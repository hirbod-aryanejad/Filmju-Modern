<UserControl x:Class="Filmju_Modern.Controls.MovieCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="150">


    <StackPanel Margin="8,8,8,0">
        <Border Width="130" Height="195"
        CornerRadius="6"
        Background="#292929">

            <Grid>
                <!-- Defines the rounded clipping shape -->
                <Border x:Name="PosterMask"
                Background="#292929"
                CornerRadius="6"/>

                <!-- Poster and rating badge are clipped by the mask -->
                <Grid>
                    <Grid.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=PosterMask}"/>
                    </Grid.OpacityMask>

                    <Image Source="{Binding PosterUrl}"
                   Stretch="UniformToFill"/>

                    <Border CornerRadius="5"
                    Background="#33171717"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="6"
                    Padding="5,3">

                        <TextBlock Text="{Binding ImdbRating, StringFormat='IMDb {0}'}"
                           Foreground="White"
                           FontSize="11"/>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <TextBlock Text="{Binding Title}"
                   Foreground="White"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Margin="0,7,0,0"
                   TextWrapping="Wrap"
                   MaxHeight="38"/>

        <TextBlock Text="{Binding Year}"
                   Foreground="#AAAAAA"
                   FontSize="11"
                   Margin="0,3,0,0"/>
    </StackPanel>
</UserControl>

